-- IMPL-IOS-01 Phase 1C — the generic on-device mirror. One row per
-- (collection, id); the backend delta's raw doc is stored as an app-layer
-- ENCRYPTED blob in payloadCipher (PHI never hits SQLite in the clear — see
-- PayloadCipher). Metadata columns (collection/id/lastUpdate/status/dirty) are
-- non-PHI and stay queryable. LWW ordering key = lastUpdate (ISO-8601 UTC,
-- lexicographically comparable). dirty = 1 while a local edit awaits push.
CREATE TABLE mirrorRow (
    collection    TEXT NOT NULL,
    id            TEXT NOT NULL,
    payloadCipher TEXT NOT NULL,
    lastUpdate    TEXT NOT NULL,
    status        TEXT NOT NULL,
    dirty         INTEGER NOT NULL DEFAULT 0,
    syncState     TEXT NOT NULL DEFAULT 'SYNCED',
    updatedAt     TEXT NOT NULL,
    PRIMARY KEY (collection, id)
);

CREATE INDEX mirrorRow_collection_status ON mirrorRow(collection, status);

upsert:
INSERT OR REPLACE INTO mirrorRow(collection, id, payloadCipher, lastUpdate, status, dirty, syncState, updatedAt)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

observeActive:
SELECT * FROM mirrorRow WHERE collection = ? AND status != 'ARCHIVED' ORDER BY lastUpdate DESC;

getById:
SELECT * FROM mirrorRow WHERE collection = ? AND id = ?;

markArchived:
UPDATE mirrorRow SET status = 'ARCHIVED', lastUpdate = ?, dirty = ?, syncState = ?, updatedAt = ?
WHERE collection = ? AND id = ?;

setSyncState:
UPDATE mirrorRow SET dirty = ?, syncState = ? WHERE collection = ? AND id = ?;

deleteRow:
DELETE FROM mirrorRow WHERE collection = ? AND id = ?;

clearAll:
DELETE FROM mirrorRow;

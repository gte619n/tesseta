<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- IMPL-16 Part A: medication dose reminders are scheduled on-device.
         POST_NOTIFICATIONS is requested at runtime from the reminder settings
         screen. Medication reminders are a core alarm-clock-style use case, so we
         declare USE_EXACT_ALARM (API 33+, granted at install, no user prompt) —
         canScheduleExactAlarms() is then always true so the scheduler uses
         setExactAndAllowWhileIdle and fires precisely even in Doze, instead of the
         windowed fallback that Doze could batch for hours (the "morning reminder
         only appeared when I opened the app" bug). SCHEDULE_EXACT_ALARM covers
         API 31–32; the windowed fallback remains only for the unusual case where
         exact access is unavailable. NOTE: USE_EXACT_ALARM is a Play Console
         policy declaration (permitted for alarm/reminder apps). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application>

        <!-- Fires at each planned reminder time (the alarm chain). -->
        <receiver
            android:name=".reminders.ReminderAlarmReceiver"
            android:exported="false" />

        <!-- Handles the notification's "Took it" / "Take all" actions. -->
        <receiver
            android:name=".reminders.ReminderActionReceiver"
            android:exported="false" />

        <!-- Re-arms the alarm chain after reboot / timezone / clock changes.
             Exported: these are protected system broadcasts only the OS sends. -->
        <receiver
            android:name=".reminders.ReminderBootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
            </intent-filter>
        </receiver>
    </application>
</manifest>

<?xml version="1.0" encoding="UTF-8"?>
<!--
  HealthFitness Info.plist (IMPL-IOS-01 Phase 2A).
  Capability keys are annotated with the decision that requires them.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDisplayName</key>
    <string>HealthFitness</string>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundlePackageType</key>
    <string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>

    <!-- D7/D8: background execution. remote-notification = silent `sync` pushes
         (content-available); fetch = BGAppRefreshTask periodic delta pull;
         processing = BGProcessingTask outbox drain on connectivity. -->
    <key>UIBackgroundModes</key>
    <array>
        <string>remote-notification</string>
        <string>fetch</string>
        <string>processing</string>
    </array>

    <!-- D8: BGTaskScheduler identifiers must be pre-declared. Refresh = periodic
         delta pull; Processing = outbox drain. Registered in SyncBridge (2C). -->
    <key>BGTaskSchedulerPermittedIdentifiers</key>
    <array>
        <string>com.gte619n.healthfitness.refresh</string>
        <string>com.gte619n.healthfitness.processing</string>
    </array>

    <!-- D12: custom scheme deep links (dose-checklist, nutrition-adjust-review,
         withings-callback). Universal links are deferred.
         D6: the Google Sign-In OAuth redirect returns via the reversed iOS
         client id scheme (HF_GOOGLE_REVERSED_CLIENT_ID, injected from a build
         setting / xcconfig — see project.yml and ios/README.md). -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>com.gte619n.healthfitness.deeplink</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>healthfitness</string>
            </array>
        </dict>
        <dict>
            <key>CFBundleURLName</key>
            <string>com.gte619n.healthfitness.googlesignin</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>$(HF_GOOGLE_REVERSED_CLIENT_ID)</string>
            </array>
        </dict>
    </array>

    <!-- D6: auth + backend config, injected from build settings (project.yml /
         local xcconfig / CI env). AppConfig + GoogleSignInService read these;
         GIDClientID also lets the SDK self-configure as a fallback. -->
    <key>HF_BACKEND_BASE_URL</key>
    <string>$(HF_BACKEND_BASE_URL)</string>
    <key>HF_GOOGLE_IOS_CLIENT_ID</key>
    <string>$(HF_GOOGLE_IOS_CLIENT_ID)</string>
    <key>HF_GOOGLE_SERVER_CLIENT_ID</key>
    <string>$(HF_GOOGLE_SERVER_CLIENT_ID)</string>
    <key>GIDClientID</key>
    <string>$(HF_GOOGLE_IOS_CLIENT_ID)</string>

    <!-- D11: AVFoundation meal capture + Vision barcode/label OCR (Wave C). -->
    <key>NSCameraUsageDescription</key>
    <string>Take photos of meals to log nutrition, and scan barcodes or nutrition labels.</string>

    <!-- D10: ActivityKit Live Activity for the active workout (lock screen +
         Dynamic Island), replacing Android's foreground-service chronometer. -->
    <key>NSSupportsLiveActivities</key>
    <true/>
    <key>NSSupportsLiveActivitiesFrequentUpdates</key>
    <true/>

    <!-- Standard scene/launch config for a SwiftUI lifecycle app. -->
    <key>UIApplicationSceneManifest</key>
    <dict>
        <key>UIApplicationSupportsMultipleScenes</key>
        <true/>
    </dict>
    <key>UILaunchScreen</key>
    <dict/>
</dict>
</plist>

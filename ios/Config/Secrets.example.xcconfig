// Template for local auth secrets (IMPL-IOS-01 Phase 2B).
//
//   cp ios/Config/Secrets.example.xcconfig ios/Config/Secrets.xcconfig
//
// then fill in the values below. Secrets.xcconfig is gitignored; this example
// is committed. Re-run `xcodegen generate` if you change which xcconfig is
// wired (not needed for value edits — those are picked up on the next build).

// Backend origin. Leave blank to use the deployed Cloud Run service. For a
// local backend from the SIMULATOR use your host loopback, e.g.:
//   HF_BACKEND_BASE_URL = http:/$()/127.0.0.1:8080
// (the `$()` keeps xcconfig from treating `//` as a comment).
HF_BACKEND_BASE_URL =

// The iOS OAuth client id from Google Cloud Console (APIs & Services →
// Credentials → OAuth client id → iOS, bundle id com.gte619n.healthfitness).
// This is the `aud` of the ID token, so it MUST be in the backend's
// OAUTH_ALLOWED_AUDIENCES.
HF_GOOGLE_IOS_CLIENT_ID = REPLACE_WITH_IOS_CLIENT_ID.apps.googleusercontent.com

// The reversed form of the iOS client id (Google lists it on the credential
// page as "iOS URL scheme"). Used as the OAuth redirect URL scheme.
HF_GOOGLE_REVERSED_CLIENT_ID = com.googleusercontent.apps.REPLACE_WITH_IOS_CLIENT_ID

// Optional: the WEB OAuth client id (same one Android uses). Only needed if you
// want a serverAuthCode; not required for the ID-token exchange.
HF_GOOGLE_SERVER_CLIENT_ID =

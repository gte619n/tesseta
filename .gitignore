# OS
.DS_Store
Thumbs.db
desktop.ini

# IDE
.idea/
.vscode/
*.iml
*.swp
.fleet/
.classpath
.project
.settings/
bin/

# Env + secrets
.env
.env.*
!.env.example
!.env.local.example
*.pem
*.key
*.p8
AuthKey_*.p8
service-account*.json
credentials*.json
# Android signing — release keystore lives only in Secret Manager.
# The shared debug keystore at android/debug.keystore IS intentionally tracked.
*-release.keystore
health-fitness-release.keystore

# Build outputs (component-specific gitignores narrow further)
**/build/
**/dist/
**/out/
**/.next/
**/node_modules/
**/.gradle/
**/.kotlin/

# Logs
*.log
npm-debug.log*
yarn-debug.log*

# Coverage
coverage/
.nyc_output/

# Temp
tmp/
.tmp/
.playwright-mcp/
.worktrees/
web/package-lock.json

# Python
__pycache__/
*.pyc

# IMPL-19 generated demo-frame previews (regenerable)
docs/test_reports/workout_logs/impl19_preview/

# Background-agent worktrees (Agent tool isolation)
.claude/worktrees/

# iOS (IMPL-IOS-01)
# The .xcodeproj is generated from ios/project.yml by XcodeGen, never committed.
ios/*.xcodeproj
ios/*.xcworkspace
ios/DerivedData/
ios/.swiftpm/
**/xcuserdata/
# Local auth secrets — real client ids live here, out of git.
# Config/Auth.xcconfig and Config/Secrets.example.xcconfig ARE tracked.
ios/Config/Secrets.xcconfig

# JVM heap dumps (e.g. Kotlin/Native OOM)
*.hprof
